---
import { site, socials, nav } from '@data/site';
import { base } from '@utils/base';
import Icon from '@components/ui/Icon.astro';
const year = new Date().getFullYear();
---
<footer class="border-t border-border bg-bg-subtle">
  <div class="container-page py-14">
    <div class="flex flex-col gap-10 md:flex-row md:items-start md:justify-between">
      <div class="max-w-sm">
        <a href={base} class="text-lg font-semibold">{site.name}</a>
        <p class="mt-3 text-sm leading-relaxed text-text-muted">
          {site.role} focused on scalable, well-architected SaaS. Open to interesting
          problems and collaborations.
        </p>
        <div class="mt-5 flex items-center gap-2">
          {socials.map((s) => (
            <a
              href={s.href}
              target={s.icon === 'mail' ? undefined : '_blank'}
              rel={s.icon === 'mail' ? undefined : 'noopener noreferrer'}
              aria-label={s.label}
              class="grid h-9 w-9 place-items-center rounded-lg border border-border bg-surface text-text-muted transition-colors hover:-translate-y-0.5 hover:border-border-strong hover:text-text"
            >
              <Icon name={s.icon} size={17} />
            </a>
          ))}
        </div>
      </div>

      <nav class="grid grid-cols-2 gap-x-12 gap-y-2" aria-label="Footer">
        <span class="col-span-2 mb-1 text-xs font-medium uppercase tracking-wider text-text-faint">Navigate</span>
        {nav.map((item) => (
          <a href={item.href} class="text-sm text-text-muted transition-colors hover:text-text">
            {item.label}
          </a>
        ))}
      </nav>
    </div>

    <div class="mt-12 flex flex-col items-start justify-between gap-3 border-t border-border pt-6 text-sm text-text-faint sm:flex-row sm:items-center">
      <p>© {year} {site.name}. All rights reserved.</p>
      <p class="flex items-center gap-1.5">
        Built with
        <a href="https://astro.build" target="_blank" rel="noopener noreferrer" class="link-underline text-text-muted">Astro</a>
        &amp; Tailwind. Press
        <kbd class="rounded border border-border bg-surface px-1.5 py-0.5 font-mono text-[10px]">⌘K</kbd>
        anywhere.
      </p>
    </div>
  </div>
</footer>
