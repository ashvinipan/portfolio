---
import Icon from '@components/ui/Icon.astro';
---
<button
  id="back-to-top"
  type="button"
  aria-label="Back to top"
  class="fixed bottom-6 right-6 z-40 grid h-11 w-11 translate-y-4 place-items-center rounded-full border border-border bg-surface text-text-muted opacity-0 shadow-lg transition-all duration-300 hover:-translate-y-0.5 hover:text-text [&.is-shown]:translate-y-0 [&.is-shown]:opacity-100"
>
  <Icon name="arrowUp" size={18} />
</button>
