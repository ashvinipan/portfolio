const isMonogram = !marks[logo];
const monogram = name.trim().charAt(0).toUpperCase();
---
{isMonogram ? (
  <span
    class="grid shrink-0 place-items-center rounded-lg bg-gradient-to-br from-brand-400/15 to-brand-600/10 font-semibold text-brand-600 dark:text-brand-300"
    style={`width:${size + 8}px;height:${size + 8}px;font-size:${size * 0.5}px`}
    aria-hidden="true"
  >{monogram}</span>
) : (
  <svg
    width={size}
    height={size}
    viewBox="0 0 24 24"
    class="shrink-0"
    role="img"
    aria-label={`${name} logo`}
    set:html={marks[logo]}
  />
)}
