---
interface Props {
  id?: string;
  class?: string;
  /** vertical rhythm */
  spacing?: 'default' | 'tight' | 'loose';
}
const { id, class: className = '', spacing = 'default' } = Astro.props;
const pad =
  spacing === 'tight'
    ? 'py-8 md:py-16'
    : spacing === 'loose'
      ? 'py-16 md:py-24'
      : 'py-10 sm:py-12 md:py-20';
---
<section id={id} class={`scroll-mt-24 ${pad} ${className}`}>
  <div class="container-page">
    <slot />
  </div>
</section>
