---
import { site, socials } from '@data/site';
import Button from '@components/ui/Button.astro';
import Icon from '@components/ui/Icon.astro';
import AuroraBackground from './AuroraBackground.astro';

// stronger snippet: multi-tenant + ACL
const codeLines = [
  { t: 1, tokens: [['cm', '// Tenant scope + ACL gate — enforced everywhere']] },
  { t: 2, tokens: [['kw', 'public function'], ['fn', ' handle'], ['pl', '(Request $req, Closure $next) {']] },
  { t: 3, tokens: [['pl', '  Tenant::'], ['fn', 'current'], ['pl', '()->'], ['fn', 'scope'], ['pl', '($req->user());']] },
  { t: 4, tokens: [['pl', '  '], ['ty', 'Gate'], ['pl', '::'], ['fn', 'authorize'], ['pl', '('], ['st', "'projects.view'"], ['pl', ');']] },
  { t: 5, tokens: [['kw', '  return'], ['pl', ' $next($req);']] },
  { t: 6, tokens: [['pl', '}']] },
];

// mini kanban columns for the dashboard preview
const board = [
  { title: 'Backlog', count: 8, tone: 'text-text-faint', items: 2 },
  { title: 'In progress', count: 3, tone: 'text-brand-500', items: 2 },
  { title: 'Done', count: 24, tone: 'text-emerald-500', items: 1 },
];
---
<section class="relative isolate overflow-hidden pt-8 pb-16 md:pt-14" data-hero>
  <AuroraBackground />

  <div class="container-page">
    <div class="grid items-center gap-12 lg:grid-cols-[1.02fr_0.98fr] lg:gap-10">
      <!-- ─────────────  LEFT  ───────────── -->
      <div class="max-w-xl">
        <span class="chip mb-6" data-reveal>
          <span class="relative flex h-2 w-2">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
          </span>
          Available for new projects
        </span>

        <h1
          class="text-balance text-4xl font-semibold leading-[1.03] tracking-[-0.03em] sm:text-5xl lg:text-6xl"
          data-reveal
          data-reveal-delay="60"
        >
          Building <span class="gradient-text">scalable web apps</span> with Laravel &amp; React.
        </h1>

        <!-- personality line -->
        <p class="mt-4 text-lg font-medium text-text md:text-xl" data-reveal data-reveal-delay="110">
          I turn complex backend systems into products people actually enjoy using.
        </p>

        <p
          class="mt-4 max-w-lg text-pretty text-base leading-relaxed text-text-muted"
          data-reveal
          data-reveal-delay="150"
        >
          {site.intro}
        </p>

        <div class="mt-7 flex flex-wrap items-center gap-3" data-reveal data-reveal-delay="220">
          <Button href="/#projects" iconRight="arrowRight">View Projects</Button>
          <Button href={site.resumeUrl} variant="ghost" icon="resume" download>Resume</Button>
          <Button href="/#contact" variant="ghost" icon="mail">Contact</Button>
        </div>

        <!-- socials
        <div class="mt-7 flex items-center gap-3" data-reveal data-reveal-delay="320">
          <span class="text-xs uppercase tracking-widest text-text-faint">Connect</span>
          <span class="h-px w-8 bg-border" aria-hidden="true"></span>
          <div class="flex items-center gap-2">
            {socials.map((s) => (
              <a
                href={s.href}
                target={s.icon === 'mail' ? undefined : '_blank'}
                rel={s.icon === 'mail' ? undefined : 'noopener noreferrer'}
                aria-label={s.label}
                class="grid h-9 w-9 place-items-center rounded-lg border border-border bg-surface text-text-muted transition-all hover:-translate-y-0.5 hover:border-border-strong hover:text-text hover:shadow-[var(--shadow-sm)]"
              >
                <Icon name={s.icon} size={17} />
              </a>
            ))}
          </div>
        </div> -->
      </div>

      <!-- ─────────────  RIGHT (product preview)  ───────────── -->
      <div
        class="relative mx-auto w-full max-w-lg lg:max-w-none"
        data-reveal
        data-reveal-delay="200"
        data-parallax
      >
        <div class="absolute inset-6 -z-10 rounded-[2rem] bg-gradient-to-br from-brand-400/25 via-brand-500/10 to-transparent blur-2xl"></div>

        <div class="card card-elevated overflow-hidden" data-preview>
          <!-- browser chrome + tabs -->
          <div class="border-b border-border bg-surface-2/60">
            <div class="flex items-center gap-2 px-4 pt-3">
              <span class="h-3 w-3 rounded-full bg-[#ff5f57]"></span>
              <span class="h-3 w-3 rounded-full bg-[#febc2e]"></span>
              <span class="h-3 w-3 rounded-full bg-[#28c840]"></span>
              <div class="mx-auto flex max-w-[60%] items-center gap-1.5 rounded-md border border-border bg-surface px-2.5 py-1 text-[11px] text-text-faint">
                <Icon name="shield" size={11} /> app.projecthub.io
              </div>
            </div>
            <div class="flex gap-1 px-3 pt-2" role="tablist" aria-label="Preview">
              <button type="button" role="tab" aria-selected="true" data-tab="dash"
                class="rounded-t-lg border border-b-0 border-transparent px-3 py-1.5 text-xs font-medium text-text-muted transition-colors data-[on]:border-border data-[on]:bg-surface data-[on]:text-text" data-on>
                Dashboard
              </button>
              <button type="button" role="tab" aria-selected="false" data-tab="code"
                class="rounded-t-lg border border-b-0 border-transparent px-3 py-1.5 text-xs font-medium text-text-muted transition-colors data-[on]:border-border data-[on]:bg-surface data-[on]:text-text">
                Code
              </button>
            </div>
          </div>

          <!-- DASHBOARD PANE -->
          <div data-pane="dash" class="grid grid-cols-[56px_1fr] sm:grid-cols-[86px_1fr] md:grid-cols-[112px_1fr]">
            <!-- sidebar -->
            <aside class="flex flex-col gap-1 border-r border-border bg-surface-2/40 p-2 sm:p-3">
              <div class="mb-2 flex items-center gap-2">
                <span class="grid h-6 w-6 place-items-center rounded-md bg-gradient-to-br from-brand-400 to-brand-600 text-[10px] font-bold text-white">P</span>
                <span class="hidden text-xs font-semibold md:inline">ProjectHub</span>
              </div>
              {[['home','Overview',true],['layers','Projects',false],['component','Tasks',false],['shield','Tickets',false],['server','Orgs',false]].map(([ic,label,on]) => (
                <span class:list={['flex items-center gap-2 rounded-md px-2 py-1.5 text-[11px]', on ? 'bg-brand-500/10 font-medium text-brand-600 dark:text-brand-300' : 'text-text-muted']}>
                  <Icon name={ic as string} size={13} /> <span class="hidden md:inline">{label}</span>
                </span>
              ))}
            </aside>

            <!-- main -->
            <div class="p-4">
              <div class="flex items-center justify-between">
                <p class="text-sm font-semibold">Overview</p>
                <span class="chip !py-1 text-[10px]">Acme Corp</span>
              </div>

              <!-- stat tiles -->
              <div class="mt-3 grid grid-cols-3 gap-2">
                {[['128','Active tasks'],['92%','On-time SLA'],['14','Projects']].map(([v,l]) => (
                  <div class="rounded-lg border border-border bg-surface p-2.5">
                    <p class="text-base font-semibold tracking-tight md:text-lg">{v}</p>
                    <p class="mt-0.5 text-[10px] leading-tight text-text-faint">{l}</p>
                  </div>
                ))}
              </div>

              <!-- mini kanban -->
              <div class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-3">
                {board.map((col) => (
                  <div class="rounded-lg border border-border bg-surface-2/50 p-2">
                    <div class="flex items-center justify-between">
                      <span class="text-[10px] font-medium text-text-muted">{col.title}</span>
                      <span class:list={['text-[10px] font-semibold', col.tone]}>{col.count}</span>
                    </div>
                    <div class="mt-1.5 space-y-1.5">
                      {Array.from({ length: col.items }).map(() => (
                        <div class="rounded-md border border-border bg-surface p-1.5">
                          <div class="h-1.5 w-3/4 rounded-full bg-border-strong/70"></div>
                          <div class="mt-1 flex items-center gap-1">
                            <span class="h-3 w-3 rounded-full bg-gradient-to-br from-brand-400 to-brand-600"></span>
                            <div class="h-1 w-1/2 rounded-full bg-border"></div>
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                ))}
              </div>

              <!-- activity line -->
              <div class="mt-3 flex items-center gap-2 rounded-lg border border-border bg-surface p-2 text-[10px] text-text-muted">
                <span class="inline-block h-1.5 w-1.5 animate-pulse rounded-full bg-emerald-500"></span>
                <span class="truncate">Ashvini moved <b class="font-medium text-text">API rate limiting</b> → Done</span>
              </div>
            </div>
          </div>

          <!-- CODE PANE -->
          <div data-pane="code" hidden>
            <pre class="overflow-x-auto p-5 font-mono text-[0.76rem] leading-[1.9] md:text-[0.8rem]"><code>{codeLines.map((line) => (
              <div class="flex gap-4">
                <span class="select-none text-text-faint/60 tabular-nums">{String(line.t).padStart(2, '0')}</span>
                <span>{line.tokens.map(([k, v]) => (
                  <span class:list={{
                    'text-brand-500 dark:text-brand-300': k === 'kw',
                    'text-emerald-600 dark:text-emerald-400': k === 'fn',
                    'text-amber-600 dark:text-amber-400': k === 'ty',
                    'text-rose-500 dark:text-rose-300': k === 'st',
                    'text-text-faint italic': k === 'cm',
                    'text-text-muted': k === 'pl',
                  }}>{v}</span>
                ))}</span>
              </div>
            ))}<div class="mt-1 flex gap-4"><span class="select-none text-text-faint/60 tabular-nums">07</span><span class="inline-block h-4 w-1.5 animate-pulse bg-brand-500 align-middle"></span></div></code></pre>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- <a
    href="/#about"
    class="mx-auto mt-14 hidden w-fit items-center gap-2 text-xs text-text-faint transition-colors hover:text-text-muted md:flex"
    aria-label="Scroll to about"
  >
    <span class="font-mono uppercase tracking-widest">Scroll</span>
    <span class="grid h-6 w-6 place-items-center rounded-full border border-border">
      <Icon name="arrowUp" size={12} class="rotate-180 animate-bounce" />
    </span>
  </a> -->
</section>

<script>
  // Tab toggle for the product preview (Dashboard ⇄ Code)
  function setupPreviewTabs() {
    document.querySelectorAll<HTMLElement>('[data-preview]').forEach((preview) => {
      if (preview.dataset.wired) return;
      preview.dataset.wired = '1';
      const tabs = preview.querySelectorAll<HTMLButtonElement>('[data-tab]');
      const panes = preview.querySelectorAll<HTMLElement>('[data-pane]');
      tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          const name = tab.dataset.tab;
          tabs.forEach((t) => {
            const on = t === tab;
            t.toggleAttribute('data-on', on);
            t.setAttribute('aria-selected', String(on));
          });
          panes.forEach((p) => p.toggleAttribute('hidden', p.dataset.pane !== name));
        });
      });
    });
  }

  // Subtle mouse parallax on the preview (desktop, motion-safe)
  function setupParallax() {
    const el = document.querySelector<HTMLElement>('[data-parallax]');
    if (!el) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (!window.matchMedia('(pointer: fine)').matches) return;
    const onMove = (e: MouseEvent) => {
      const cx = window.innerWidth / 2;
      const cy = window.innerHeight / 2;
      const dx = (e.clientX - cx) / cx;
      const dy = (e.clientY - cy) / cy;
      el.style.transform = `translate3d(${dx * 8}px, ${dy * 8}px, 0)`;
    };
    window.addEventListener('mousemove', onMove, { passive: true });
  }

  function init() { setupPreviewTabs(); setupParallax(); }
  document.addEventListener('astro:page-load', init);
  if (document.readyState !== 'loading') init();
  else document.addEventListener('DOMContentLoaded', init);
</script>
