---
import Section from '@components/ui/Section.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';
import Icon from '@components/ui/Icon.astro';
import { experience } from '@data/experience';
---
<Section id="experience">
  <SectionHeading
    eyebrow="Experience"
    title="Where I’ve shipped."
    description="A track record of owning features end-to-end — from data model to production."
  />

  <ol class="relative mt-12 space-y-10 before:absolute before:left-[7px] before:top-2 before:h-[calc(100%-1rem)] before:w-px before:bg-gradient-to-b before:from-brand-500/60 before:via-border before:to-transparent md:before:left-[9px]">
    {experience.map((job, i) => (
      <li class="relative pl-8 md:pl-12" data-reveal data-reveal-delay={String(i * 90)}>
        <span class="absolute left-0 top-1.5 grid h-4 w-4 place-items-center rounded-full border-2 border-brand-500 bg-bg md:h-5 md:w-5">
          <span class="h-1.5 w-1.5 rounded-full bg-brand-500"></span>
        </span>

        <div class="card card-hover p-6 md:p-7">
          <div class="flex flex-wrap items-start justify-between gap-2">
            <div>
              <h3 class="text-lg font-semibold">{job.role}</h3>
              <p class="text-brand-500 dark:text-brand-300">{job.company}</p>
            </div>
            <div class="text-right text-sm text-text-muted">
              <p class="font-mono">{job.duration}</p>
              <p class="text-text-faint">{job.location}</p>
            </div>
          </div>

          <p class="mt-3 text-sm leading-relaxed text-text-muted">{job.summary}</p>

          <ul class="mt-4 space-y-2">
            {job.achievements.map((a) => (
              <li class="flex gap-2.5 text-sm leading-relaxed">
                <Icon name="check" size={16} class="mt-0.5 shrink-0 text-brand-500 dark:text-brand-300" />
                <span class="text-text-muted">{a}</span>
              </li>
            ))}
          </ul>

          <ul class="mt-5 flex flex-wrap gap-1.5">
            {job.stack.map((t) => (
              <li class="chip">{t}</li>
            ))}
          </ul>
        </div>
      </li>
    ))}
  </ol>
</Section>
