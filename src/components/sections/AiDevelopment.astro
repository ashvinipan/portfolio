---
import Section from '@components/ui/Section.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';
import Icon from '@components/ui/Icon.astro';
import { aiIntro, aiTools, aiPrinciples } from '@data/ai';
---
<Section id="ai">
  <div class="grid gap-12 lg:grid-cols-[1fr_1fr] lg:gap-16">
    <div>
      <SectionHeading
        eyebrow="AI Development"
        title="AI as a force multiplier — with the judgement kept human."
        description={aiIntro}
      />

      <ul class="mt-8 space-y-3" data-reveal data-reveal-delay="80">
        {aiPrinciples.map((p) => (
          <li class="flex items-start gap-3 rounded-xl border border-border bg-surface p-4">
            <Icon name="spark" size={18} class="mt-0.5 shrink-0 text-brand-500 dark:text-brand-300" />
            <span class="text-sm leading-relaxed text-text-muted">{p}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="grid content-start gap-3">
      {aiTools.map((tool, i) => (
        <div
          class="group card card-hover flex items-center gap-4 p-5"
          data-reveal
          data-reveal-delay={String(i * 60)}
        >
          <div class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-gradient-to-br from-brand-400/20 to-brand-600/10 font-mono text-sm font-bold text-brand-600 dark:text-brand-300">
            {tool.name.slice(0, 2).toUpperCase()}
          </div>
          <div class="min-w-0">
            <h3 class="font-semibold">{tool.name}</h3>
            <p class="mt-0.5 text-sm leading-relaxed text-text-muted">{tool.use}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</Section>
