---
import Section from '@components/ui/Section.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';
import Icon from '@components/ui/Icon.astro';
import { projects } from '@data/projects';

const featured = projects.filter((p) => p.featured);
---
<Section id="projects">
  <SectionHeading
    eyebrow="Featured Projects"
    title="Selected work, with the reasoning behind it."
    description="Not screenshots and stacks — the actual problem each project solved and how it was architected."
  />

  <div class="mt-12 space-y-8">
    {featured.map((project, i) => (
      <article
        class="card card-hover group grid overflow-hidden lg:grid-cols-2"
        data-reveal
        data-reveal-delay={String(i * 60)}
      >
        <!-- media -->
        <div class:list={[
          'relative min-h-64 overflow-hidden bg-gradient-to-br from-surface-2 to-bg-subtle',
          i % 2 === 1 ? 'lg:order-2' : '',
        ]}>
          <img
            src={project.image}
            alt={project.imageAlt}
            width="720"
            height="480"
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.04]"
          />
          <span class="absolute left-4 top-4 chip glass">{project.year}</span>
        </div>

        <!-- body -->
        <div class="flex flex-col p-6 md:p-8">
          <h3 class="text-xl font-semibold md:text-2xl">{project.title}</h3>
          <p class="mt-1 text-brand-500 dark:text-brand-300">{project.tagline}</p>
          <p class="mt-3 text-sm leading-relaxed text-text-muted">{project.description}</p>

          <dl class="mt-5 space-y-3 text-sm">
            <div>
              <dt class="font-medium text-text">Challenge</dt>
              <dd class="mt-0.5 leading-relaxed text-text-muted">{project.challenge}</dd>
            </div>
            <div>
              <dt class="font-medium text-text">Architecture</dt>
              <dd class="mt-0.5 leading-relaxed text-text-muted">{project.architecture}</dd>
            </div>
          </dl>

          <ul class="mt-5 flex flex-wrap gap-1.5">
            {project.stack.map((t) => <li class="chip">{t}</li>)}
          </ul>

          {project.companyProject && (
            <div class="mt-auto flex items-center gap-1.5 pt-6 text-xs text-text-faint">
              <Icon name="shield" size={14} /> Company project · private codebase
            </div>
          )}
        </div>
      </article>
    ))}
  </div>
</Section>
