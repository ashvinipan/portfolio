---
import Section from '@components/ui/Section.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';
import Icon from '@components/ui/Icon.astro';
import { highlights } from '@data/highlights';
---
<Section id="highlights" class="bg-bg-subtle border-y border-border">
  <SectionHeading
    eyebrow="Engineering Highlights"
    title="What I actually do, day to day."
    description="The recurring engineering wins behind the products — the reasons systems stay fast, safe, and maintainable."
  />

  <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {highlights.map((h, i) => (
      <div
        class="group card card-hover relative overflow-hidden p-6"
        data-reveal
        data-reveal-delay={String((i % 3) * 70)}
      >
        <div class="grid h-11 w-11 place-items-center rounded-xl border border-border bg-surface-2 text-brand-500 transition-colors duration-300 group-hover:border-brand-500/40 group-hover:text-brand-600 dark:text-brand-300">
          <Icon name={h.icon} size={22} />
        </div>
        <h3 class="mt-4 font-semibold">{h.title}</h3>
        <p class="mt-2 text-sm leading-relaxed text-text-muted">{h.body}</p>
      </div>
    ))}
  </div>
</Section>
