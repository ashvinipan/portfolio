---
import Section from '@components/ui/Section.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';
import Icon from '@components/ui/Icon.astro';
import Button from '@components/ui/Button.astro';
import { site, socials, availableFor, openToRoles } from '@data/site';
---
<Section id="contact" class="bg-bg-subtle border-t border-border">
  <div class="grid gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16">
    <div>
      <SectionHeading
        eyebrow="Contact"
        title="Let’s build something amazing together."
        description="Whether you’re hiring, starting a new project, or just want to chat about software engineering, I’d love to hear from you. I usually reply within 24 hours."
      />

      <div class="mt-8 space-y-3">
        <button
          type="button"
          data-copy={site.email}
          class="group flex w-full items-center gap-3 rounded-xl border border-border bg-surface p-4 text-left transition-all hover:-translate-y-0.5 hover:border-brand-500/60 [&.copied]:border-brand-500/60"
        >
          <span class="grid h-10 w-10 place-items-center rounded-lg bg-surface-2 text-brand-500 dark:text-brand-300">
            <Icon name="mail" size={18} />
          </span>
          <span class="min-w-0 flex-1">
            <span class="block text-xs text-text-faint">Email</span>
            <span class="block truncate font-medium">{site.email}</span>
          </span>
          <span class="flex items-center gap-1.5 text-xs text-text-muted" data-copy-label>
            <Icon name="copy" size={15} /> Copy
          </span>
        </button>

        {socials.filter((s) => s.icon !== 'mail').map((s) => (
          <a
            href={s.href}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center gap-3 rounded-xl border border-border bg-surface p-4 transition-all hover:-translate-y-0.5 hover:border-brand-500/60"
          >
            <span class="grid h-10 w-10 place-items-center rounded-lg bg-surface-2 text-text-muted transition-colors group-hover:text-text">
              <Icon name={s.icon} size={18} />
            </span>
            <span class="min-w-0 flex-1">
              <span class="block text-xs text-text-faint">{s.label}</span>
              <span class="block truncate font-medium">{s.handle}</span>
            </span>
            <Icon name="arrowUpRight" size={16} class="text-text-faint transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
          </a>
        ))}
      </div>

      <div class="mt-8">
        <p class="text-xs font-medium uppercase tracking-wide text-text-faint">Currently interested in</p>
        <ul class="mt-3 flex flex-wrap gap-2">
          {openToRoles.map((role) => (
            <li class="inline-flex items-center gap-1.5 rounded-full border border-border bg-surface px-3 py-1.5 text-sm text-text-muted">
              <Icon name="check" size={14} class="text-brand-500 dark:text-brand-300" />
              {role}
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div
      class="card card-elevated relative overflow-hidden p-6 md:p-8"
      data-reveal
      data-reveal-delay="80"
    >
      <!-- ambient brand glow, sits behind content -->
      <span
        aria-hidden="true"
        class="pointer-events-none absolute -right-16 -top-16 h-48 w-48 rounded-full bg-brand-500/15 blur-3xl"
      ></span>

      <div class="relative">
        <span class="inline-flex items-center gap-2 rounded-full border border-border bg-surface-2 px-3 py-1 text-xs font-medium text-text-muted">
          <span class="relative flex h-2 w-2">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-500/70"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
          </span>
          Available for new work
        </span>

        <h3 class="mt-5 text-xl font-semibold leading-snug">Let’s connect.</h3>
        <p class="mt-2 text-sm text-text-muted leading-relaxed">
          Send a note about your role or project and I’ll get back to you personally.
        </p>

        <div class="mt-6 space-y-4 border-t border-border pt-6">
          <div class="flex items-center gap-2 text-sm font-medium">
            <Icon name="map" size={16} class="text-text-muted" />
            {site.location.split(',')[0]}, India
          </div>
          <div>
            <p class="text-xs text-text-faint">Available for</p>
            <ul class="mt-2 flex flex-wrap gap-2">
              {availableFor.map((mode) => (
                <li class="rounded-md bg-surface-2 px-2.5 py-1 text-xs font-medium text-text-muted">{mode}</li>
              ))}
            </ul>
          </div>
        </div>

        <div class="mt-7 flex flex-col gap-3 sm:flex-row">
          <Button
            href={`mailto:${site.email}?subject=${encodeURIComponent('Portfolio enquiry')}`}
            iconRight="arrowRight"
            class="flex-1"
          >
            Get in Touch
          </Button>
          <Button
            href={site.resumeUrl}
            variant="ghost"
            icon="resume"
            external
            class="flex-1"
          >
            Resume
          </Button>
        </div>
      </div>
    </div>
  </div>
</Section>
